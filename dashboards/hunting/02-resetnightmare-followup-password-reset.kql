// Hunt companion to detection 02: a bare-UPN change followed within 1h by a password change on a different account
let UpnChanges = IdentityDirectoryEvents
    | where Timestamp > ago(30d) and ActionType has "Upn"
    | extend AF = todynamic(AdditionalFields)
    | mv-apply kv = AF on (
        extend k = tostring(bag_keys(kv)[0])
        | where k matches regex @"(?i)^\s*TO\b.*upn"
        | summarize NewUpn = tolower(trim(@"\s", tostring(take_any(kv[k]))))
      )
    | where isnotempty(NewUpn) and NewUpn !contains "@"
    | project UpnTime = Timestamp, UpnActor = AccountName, UpnTarget = TargetAccountUpn, NewUpn;
let Victims = IdentityInfo
    | where Timestamp > ago(30d)
    | summarize arg_max(Timestamp, AccountUpn) by Sam = tolower(AccountName)
    | project Sam, VictimUpn = AccountUpn;
let Resets = IdentityDirectoryEvents
    | where Timestamp > ago(30d) and ActionType has "Password"
    | project ResetTime = Timestamp, ResetActionType = ActionType, ResetTarget = tolower(TargetAccountUpn), ResetActor = AccountName, ResetFrom = DeviceName;
UpnChanges
| join kind=inner Victims on $left.NewUpn == $right.Sam
| extend VictimKey = tolower(VictimUpn)
| join kind=inner Resets on $left.VictimKey == $right.ResetTarget
| where ResetTime between (UpnTime .. (UpnTime + 1h))
| project UpnTime, UpnActor, UpnTarget, NewUpn, VictimUpn, ResetTime, ResetActionType, ResetActor, ResetFrom
