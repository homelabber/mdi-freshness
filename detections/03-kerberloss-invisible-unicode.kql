// Gap 3 - KerberLoss (CVE-2026-25177): invisible / format Unicode written into UPN, SPN or account names
// Matches both raw characters and JSON-escaped \uXXXX forms in AdditionalFields.
let RawInvisible = @"[\x{00AD}\x{034F}\x{061C}\x{115F}\x{1160}\x{17B4}\x{17B5}\x{180E}\x{2000}-\x{200F}\x{2028}-\x{202F}\x{205F}-\x{206F}\x{3000}\x{3164}\x{FEFF}\x{FFA0}]";
let EscapedInvisible = @"(?i)\\u(00ad|034f|061c|115f|1160|17b4|17b5|180e|200[0-9a-f]|202[89a-f]|205f|206[0-9a-f]|3000|3164|feff|ffa0)";
IdentityDirectoryEvents
| where Timestamp > ago(1h)
| where ActionType has_any ("Upn", "Name", "Spn", "Service Principal", "Account Created")
| extend AF = tostring(AdditionalFields)
| where AF matches regex RawInvisible or AF matches regex EscapedInvisible
    or TargetAccountUpn matches regex RawInvisible
    or TargetAccountDisplayName matches regex RawInvisible
| project Timestamp, ReportId, ActionType, AccountName, AccountDomain, AccountUpn, TargetAccountUpn,
    TargetAccountDisplayName, TargetDeviceName, DeviceName, AdditionalFields
