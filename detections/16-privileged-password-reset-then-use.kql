// AD Sequence 16 - Privileged account password reset by someone else, then that account signs in within 24h
// Source: Microsoft Threat Intelligence - domain-compromise case (Apr 2026): the actor reset privileged
// passwords and immediately reused them. Alerts on the first sign-in after the reset.
let ApprovedResetters = dynamic([]);   // TUNE: helpdesk / PAM accounts that legitimately reset admin passwords
let PrivilegedGroups = dynamic(["Domain Admins", "Enterprise Admins", "Schema Admins", "Administrators",
    "Account Operators", "Backup Operators", "Server Operators", "Print Operators", "DnsAdmins", "Group Policy Creator Owners"]);
let Privileged = IdentityInfo
    | where Timestamp > ago(14d) and isnotempty(AccountUpn)
    | summarize arg_max(Timestamp, CriticalityLevel, Tags, GroupMembership) by AccountUpn
    | where CriticalityLevel > 0 or tostring(Tags) has_any ("Sensitive", "Admin", "Privileged")
        or tostring(GroupMembership) has_any (PrivilegedGroups)
    | project VictimUpn = tolower(AccountUpn), CriticalityLevel, Tags;
let Resets = IdentityDirectoryEvents
    | where Timestamp > ago(25h)
    | where ActionType has "Password" and ActionType has_any ("reset", "changed")
    | where isnotempty(TargetAccountUpn) and isnotempty(AccountName)
    | extend VictimUpn = tolower(TargetAccountUpn)
    | where tolower(AccountUpn) != VictimUpn and tolower(AccountName) != tolower(tostring(split(VictimUpn, "@")[0]))
    | where not(AccountName in~ (ApprovedResetters))
    | join kind=inner Privileged on VictimUpn
    | project ResetTime = Timestamp, VictimUpn, ResetBy = AccountName, ResetByDomain = AccountDomain,
        ResetFromDevice = DeviceName, ResetFromIP = IPAddress, CriticalityLevel, Tags;
IdentityLogonEvents
| where Timestamp > ago(1h)
| where ActionType == "LogonSuccess" and isnotempty(AccountUpn)
| extend VictimUpn = tolower(AccountUpn)
| join kind=inner Resets on VictimUpn
| where Timestamp between (ResetTime .. (ResetTime + 24h))
| summarize arg_min(Timestamp, ReportId, AccountName, AccountDomain, AccountUpn, DeviceName, IPAddress, Protocol,
    DestinationDeviceName, LogonType) by VictimUpn, ResetTime, ResetBy
| project Timestamp, ReportId, AccountName, AccountDomain, AccountUpn, DeviceName, IPAddress, Protocol, LogonType,
    DestinationDeviceName, ResetTime, ResetBy, MinutesAfterReset = datetime_diff("minute", Timestamp, ResetTime)
